# Configure in Vercel Project Settings > Environment Variables.
# For local testing, copy to .env.local and fill in the token.
ANNOTATION_GITHUB_TOKEN=
ANNOTATION_GITHUB_REPOSITORY=mhage82/inline-image-classifier
ANNOTATION_GITHUB_BRANCH=main
ANNOTATION_GITHUB_PATH=data/annotations/raw
# Optional shared class code; leave blank for the name-and-group-only flow.
ANNOTATION_ACCESS_CODE=
