{
  "schema_version": 1,
  "study": {
    "schema_version": 1,
    "guidelines_version": "2.0",
    "title": "Image quality annotation",
    "contact": "",
    "return_instructions": "Download your results JSON and return it to the project organizer using the channel they gave you.",
    "labels": [
      {
        "id": "physical_obstruction",
        "name": "Physical Obstruction",
        "description": "A nearby object, such as a finger, strap, or lens hood, blocks part of the camera view. Ordinary objects overlapping within the scene alone do not count.",
        "example": "A fingertip covers one corner while the rest of the scene remains visible."
      },
      {
        "id": "exposure_fault",
        "name": "Exposure Fault",
        "description": "Overexposure washes out detail, or underexposure makes important detail too dark to distinguish. A bright or dark scene alone is not enough.",
        "example": "A bright region loses its texture, or an underexposed subject loses detail in deep shadows."
      },
      {
        "id": "lens_contamination",
        "name": "Lens Contamination",
        "description": "Water droplets, dirt, dust, fingerprints, or smears on the lens or glass in front of the camera create visible spots, distortion, or localized softness. Rain or dirt on objects in the scene alone does not count.",
        "example": "Two droplets cause distorted patches while the rest of the image is sharp."
      },
      {
        "id": "optical_motion_blur",
        "name": "Optical/Motion Blur",
        "description": "Optical defocus makes intended detail soft or out of focus, or movement creates visible smearing, streaks, or doubled outlines. A deliberately blurred background alone does not count when the main subject is sharp.",
        "example": "The main subject is out of focus, or a moving subject has streaked edges."
      },
      {
        "id": "lens_fog_condensation",
        "name": "Lens Fog / Condensation",
        "description": "A misty or milky veil on the lens reduces contrast or obscures detail. Atmospheric fog within the scene alone does not count. Select this when the image supports fogging of the lens or camera glass.",
        "example": "Lens condensation creates a milky veil and halos around bright areas."
      }
    ],
    "examples": []
  },
